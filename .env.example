# Configurações do Refúgio Blog & Community Hub
APP_NAME="O Refúgio"
APP_ENV=development
BASE_URL=http://localhost:8000
SECRET_KEY=refugio-secret-key-indieweb-2026-matrix-reloaded-super-secure

# Banco de Dados (SQLite por padrão)
DATABASE_URL=sqlite:///./blog.db

# Credenciais de Administrador Padrão (Seed Automático)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=refugio2026!
ADMIN_EMAIL=admin@refugio.local

# Notificações via Gmail SMTP (Opcional - deixe vazio se não for usar em dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="O Refúgio Bot"
